<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.2.0.0</Version>
    <Description>Annoyed by certain people or emotes? Want to disable the yelps and whines of the ambient crowd noises? Enjoy this one~&#10;/willomuter to open settings</Description>
    <PackageProjectUrl>https://github.com/NeonGhostCinnamon/WillOMuter</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Nunito Black (SIL Open Font License), the font used on will-o-cinnamon.com -->
    <Content Include="Nunito-Black.ttf" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="Nunito-OFL.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
